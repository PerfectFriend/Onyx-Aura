# Nailix uses zero runtime LLM API keys; unused AI template variables removed in Sprint 5.1.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Stage 4 · Sprint 4.2 — Optional Server Identity & Hosted Stripe Checkout (SAQ-A)
# Leave unset for local [SIM] preview mode; NEVER commit real keys to Git.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NAILIX_SESSION_SECRET=""
NAILIX_STRICT_SECRETS="0"
NAILIX_MASTER_INVITE_CODES=""
NAILIX_FRAME_ANCESTORS="'self' https://aistudio.google.com https://*.google.com"
NAILIX_ALLOWED_ORIGINS=""
TRUST_PROXY="0"
